{
  "id": "example-cli",
  "displayName": "Example CLI",
  "names": ["example", "ex"],
  "category": "developer-tool",
  "versionCommands": [["--version"], ["version"]],
  "update": {
    "executable": "{self}",
    "args": ["update"]
  },
  "diagnose": {
    "executable": "{self}",
    "args": ["doctor"]
  },
  "auth": null,
  "dependencies": ["node"],
  "matchers": [
    {
      "name": "example",
      "pathContains": [],
      "packageNames": []
    },
    {
      "name": "ex",
      "pathContains": ["/example-cli/"],
      "packageNames": []
    }
  ],
  "configPaths": ["~/.config/example/config.json"],
  "configCommand": null
}
